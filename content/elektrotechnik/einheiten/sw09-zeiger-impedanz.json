    {
      "id": "impedanz",
      "titel": "Impedanz und Admittanz",
      "art": "verstaendnis",
      "dauer_min": 4,
      "inhalt": [
        {
          "typ": "text",
          "text": "Die **Impedanz** ist das Verhältnis von Spannungs- zu Stromzeiger – der Wechselstromwiderstand mit Phasenverschiebung. Ihr Winkel ist die Phasenverschiebung zwischen U und I."
        },
        {
          "typ": "formel",
          "tex": "Z = \\frac{U\\angle\\varphi_u}{I\\angle\\varphi_i} = Z\\angle(\\varphi_u - \\varphi_i) \\qquad Y = \\frac{1}{Z},\\; \\varphi_Y = -\\varphi_Z"
        },
        {
          "typ": "liste",
          "punkte": [
            "$Z_R = R\\angle0°$",
            "$Z_C = \\dfrac{1}{\\omega C}\\angle-90°$",
            "$Z_L = \\omega L\\angle+90°$"
          ]
        },
        {
          "typ": "titel",
          "text": "Typ der Schaltung"
        },
        {
          "typ": "liste",
          "punkte": [
            "$\\varphi_Z > 0°$: **ohmsch-induktiv**, die Spannung eilt dem Strom voraus",
            "$\\varphi_Z = 0°$: rein ohmsch",
            "$\\varphi_Z < 0°$: **ohmsch-kapazitiv**, die Spannung eilt dem Strom nach"
          ]
        }
      ],
      "aufgaben": [
        {
          "id": "q1",
          "typ": "multiple_choice",
          "frage": "Eine Impedanz hat den Winkel $+35°$. Wie verhält sich die Schaltung?",
          "optionen": [
            "Ohmsch-induktiv",
            "Ohmsch-kapazitiv",
            "Rein ohmsch",
            "Rein kapazitiv"
          ],
          "richtig": 0,
          "erklaerung": "$\\varphi_Z > 0$ → induktiv, die Spannung eilt dem Strom voraus."
        },
        {
          "id": "q2",
          "typ": "wahr_falsch",
          "erklaerung": "$Y = 1/Z$ → Betrag als Kehrwert, Winkel mal −1.",
          "aussage": "Der Winkel der Admittanz ist das Negative des Impedanzwinkels.",
          "richtig": true
        },
        {
          "id": "q3",
          "typ": "multiple_choice",
          "frage": "Welche Impedanz hat ein idealer Kondensator?",
          "optionen": [
            "$\\dfrac{1}{\\omega C}\\angle-90°$",
            "$\\omega C\\angle+90°$",
            "$\\omega L\\angle+90°$",
            "$R\\angle0°$"
          ],
          "richtig": 0,
          "erklaerung": "$Z_C = X_C\\angle-90°$ mit $X_C = 1/(\\omega C)$."
        }
      ]
    },
    {
      "id": "ac-netzwerke",
      "titel": "AC-Netzwerke berechnen",
      "art": "rechnen",
      "dauer_min": 5,
      "inhalt": [
        {
          "typ": "text",
          "text": "Gerechnet wird wie bei Gleichstrom – nur mit Zeigern. Kirchhoff gilt auch hier: $\\sum I_k = 0$, $\\sum U_k = 0$, und $U = Z\\cdot I$."
        },
        {
          "typ": "liste",
          "punkte": [
            "**Reihenschaltung:** Spannungen addieren → **Impedanzen** addieren: $Z = Z_1 + Z_2 + \\dots$",
            "**Parallelschaltung:** Ströme addieren → **Admittanzen** addieren: $Y = Y_1 + Y_2 + \\dots$",
            "Gemischt: Teile getrennt rechnen, beim Wechsel Z ↔ Y Kehrwert des Betrags und Winkel mal −1"
          ]
        }
      ],
      "aufgaben": [
        {
          "id": "q1",
          "typ": "rechnung",
          "frage": "$U = 16\\,\\text{V}\\angle0°$ liegt an $R = 3\\,\\Omega$ parallel zu $X_C = 4\\,\\Omega$. Wie gross ist der Betrag des Gesamtstroms?",
          "loesung": 6.67,
          "einheit": "A",
          "toleranz": 0.02,
          "quelle": "Block 6, S. 29–30",
          "loesungsweg": [
            "$I_R = \\dfrac{16\\,\\text{V}\\angle0°}{3\\,\\Omega\\angle0°} = 5.333\\,\\text{A}\\angle0°$",
            "$I_C = \\dfrac{16\\,\\text{V}\\angle0°}{4\\,\\Omega\\angle-90°} = 4\\,\\text{A}\\angle+90°$",
            "$I = I_R + I_C = 6.67\\,\\text{A}\\angle36.9°$"
          ]
        },
        {
          "id": "q2",
          "typ": "rechnung",
          "frage": "$U = 10\\,\\text{V}\\angle0°$, 200 Hz: $L = 60\\,\\text{mH}$ in Serie zu ($R = 50\\,\\Omega \\parallel C = 20\\,\\mu\\text{F}$). Betrag des Stroms in mA?",
