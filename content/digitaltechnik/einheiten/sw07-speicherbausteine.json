{
  "id": "sw07-speicherbausteine",
  "titel": "Speicherbausteine: Latch und Flip-Flop",
  "kapitel": 7,
  "beschreibung": "SR-Latch, Enable, D-Latch, flankengetriggertes D-FF (Master-Slave), JK- und T-Flip-Flop",
  "lektionen": [
    {
      "id": "sw07-speicherbausteine-l1",
      "titel": "Speichern durch Rückkopplung",
      "art": "verstaendnis",
      "schritte": [
        {
          "typ": "theorie",
          "titel": "Wozu Speicherbausteine?",
          "bloecke": [
            {
              "typ": "text",
              "text": "Speicherbausteine sollen das **Auftreten von kurzen Ereignissen speichern** können."
            },
            {
              "typ": "text",
              "text": "**Beispiel aus den Folien:** Ein kurzer Tastendruck weit vor der Tramhaltestelle soll gespeichert werden. Ausgewertet wird er erst, wenn das Tram hält und die Türsperren freigegeben sind."
            },
            {
              "typ": "zeitdiagramm",
              "titel": "Kurzer Tastendruck, Wert bleibt gespeichert",
              "signale": [
                {
                  "name": "Taste",
                  "wellen": "001100000000"
                },
                {
                  "name": "Gespeichert",
                  "wellen": "000111111111"
                }
              ],
              "marken": [
                {
                  "t": 10,
                  "text": "Tram hält"
                }
              ]
            }
          ],
          "quelle": "K07 Folie 3"
        },
        {
          "typ": "theorie",
          "titel": "Das Prinzip",
          "bloecke": [
            {
              "typ": "text",
              "text": "Das Eingangssignal wird durch eine **kombinatorische Schaltung** verarbeitet. Das Ausgangssignal wird **zum Eingang zurückgeführt**."
            },
            {
              "typ": "text",
              "text": "Damit «hält» sich das Ausgangssignal: Es besteht weiter, auch wenn das Eingangssignal abbricht."
            },
            {
              "typ": "merke",
              "text": "Speichern = kombinatorische Logik plus Rückkopplung vom Ausgang zum Eingang."
            }
          ],
          "quelle": "K07 Folien 3–4"
        },
        {
          "typ": "wahr_falsch",
          "aussage": "Bei einem Speicherbaustein bleibt der Ausgang bestehen, auch wenn das Eingangssignal wieder abbricht.",
          "richtig": true,
          "erklaerung": "Genau dafür sorgt die Rückkopplung des Ausgangs auf den Eingang.",
          "quelle": "K07 Folie 3",
          "id": "sw07-speicherbausteine-l1-a1"
        },
        {
          "typ": "multiple_choice",
          "frage": "Was macht aus einer kombinatorischen Schaltung einen Speicher?",
          "optionen": [
            "Die Rückführung des Ausgangs zum Eingang",
            "Ein schnellerer Takt",
            "Mehr Eingänge",
            "Ein grösserer Widerstand"
          ],
          "richtig": 0,
          "erklaerung": "Ohne Rückkopplung hängt der Ausgang nur vom aktuellen Eingang ab.",
          "quelle": "K07 Folie 3",
          "id": "sw07-speicherbausteine-l1-a2"
        },
        {
          "typ": "multiple_choice",
          "frage": "Im Tram-Beispiel: Warum braucht es einen Speicher?",
          "optionen": [
            "Der Tastendruck ist kurz, ausgewertet wird er aber erst später",
            "Die Taste prellt nie",
            "Damit die Tür schneller aufgeht",
            "Weil der Tastendruck sehr lange dauert"
          ],
          "richtig": 0,
          "erklaerung": "Das kurze Ereignis muss bis zur Auswertung an der Haltestelle festgehalten werden.",
          "quelle": "K07 Folie 3",
          "id": "sw07-speicherbausteine-l1-a3"
        }
      ]
    },
    {
      "id": "sw07-speicherbausteine-l2",
      "titel": "Das SR-Latch",
      "art": "verstaendnis",
      "schritte": [
        {
          "typ": "theorie",
          "titel": "Setzen, Rücksetzen, Speichern",
          "bloecke": [
            {
              "typ": "text",
              "text": "Das **SR-Latch** (oft auch RS-Latch) besteht aus zwei rückgekoppelten NOR-Gattern. *Latch* heisst «Einrasten», z. B. einer Türe."
            },
            {
              "typ": "liste",
              "punkte": [
                "**S** steht für *Set* (Setzen), **R** für *Reset* (Rücksetzen), **Q** ist der Ausgang.",
                "$Q_n$ ist der Ausgangswert im Zeitpunkt $t_n$, $Q_{n+1}$ der Wert danach."
              ]
            },
            {
              "typ": "tabelle",
              "titel": "Funktionstabelle SR-Latch",
              "kopf": [
                "S",
                "R",
                "$Q_{n+1}$",
                "Bedeutung"
              ],
              "zeilen": [
                [
                  "0",
                  "0",
                  "$Q_n$",
                  "speichern"
                ],
                [
                  "0",
                  "1",
                  "0",
                  "rücksetzen"
                ],
                [
                  "1",
                  "0",
                  "1",
                  "setzen"
                ],
                [
                  "1",
                  "1",
                  "–",
                  "verboten"
                ]
              ]
            },
            {
              "typ": "hinweis",
              "text": "Die Wahrheitstabelle von Latches und Flip-Flops heisst auch **Funktionstabelle** oder **Anregungstabelle** (Excitation Table)."
            }
          ],
          "quelle": "K07 Folie 5"
        },
        {
          "typ": "theorie",
          "titel": "Probier es aus",
          "bloecke": [
            {
              "typ": "text",
              "text": "Schalte S und R um. Achte darauf, was bei S = R = 0 passiert, und was beim verbotenen Fall S = R = 1."
            },
            {
              "typ": "interaktiv",
              "widget": "sr_latch"
            }
          ],
          "quelle": "K07 Folien 5, 8"
        },
        {
          "typ": "theorie",
          "titel": "Anwendung: Entprellen",
          "bloecke": [
            {
              "typ": "text",
              "text": "Ein mechanischer Schalter **prellt**: Beim Umschalten springt der Kontakt mehrmals auf und zu, bevor er ruhig bleibt."
            },
            {
              "typ": "zeitdiagramm",
              "titel": "Prellender Schalter",
              "signale": [
                {
                  "name": "Kontakt",
                  "wellen": "000101011111"
                }
              ]
            },
            {
              "typ": "text",
              "text": "Bei einem **Umschalter** liegt ein Kontakt an S, der andere an R. Der erste Kontakt setzt (bzw. rücksetzt) das Latch. Weiteres Prellen am gleichen Kontakt setzt nur nochmals denselben Wert, dazwischen gilt S = R = 0 und das Latch speichert. Q wechselt so genau einmal."
            }
          ],
          "quelle": "K07 Folie 6"
        },
        {
          "typ": "lueckentext",
          "text": "Beim SR-Latch steht S für ___ und R für ___.",
          "antworten": [
            [
              "Set",
              "Setzen"
            ],
            [
              "Reset",
              "Rücksetzen",
              "Ruecksetzen"
            ]
          ],
          "erklaerung": "S = Set (Setzen), R = Reset (Rücksetzen).",
          "quelle": "K07 Folie 5",
          "id": "sw07-speicherbausteine-l2-a1"
        },
        {
          "typ": "multiple_choice",
          "frage": "Was macht ein SR-Latch bei S = 0 und R = 0?",
          "optionen": [
            "Es speichert den bisherigen Wert",
            "Q wird 0",
            "Q wird 1",
            "Q wechselt jedes Mal"
          ],
          "richtig": 0,
          "erklaerung": "$Q_{n+1} = Q_n$: Die Rückkopplung hält den Wert.",
          "quelle": "K07 Folie 5",
          "id": "sw07-speicherbausteine-l2-a2"
        },
        {
          "typ": "wahr_falsch",
          "aussage": "S = R = 1 ist beim SR-Latch eine ganz normale, erlaubte Eingangskombination.",
          "richtig": false,
          "erklaerung": "S = R = 1 ist der instabile, verbotene Zustand.",
          "quelle": "K07 Folie 8",
          "id": "sw07-speicherbausteine-l2-a3"
        },
        {
          "typ": "multiple_choice",
          "frage": "Warum entprellt ein SR-Latch einen Umschalter?",
          "optionen": [
            "Wiederholtes Prellen am gleichen Kontakt setzt nur nochmals denselben Wert",
            "Weil das Latch langsamer ist als das Prellen",
            "Weil S und R gleichzeitig 1 werden",
            "Weil das Latch das Prellen verstärkt"
          ],
          "richtig": 0,
          "erklaerung": "Zwischen den Prellern gilt S = R = 0, das Latch hält den Wert. Q wechselt nur einmal.",
          "quelle": "K07 Folie 6",
          "id": "sw07-speicherbausteine-l2-a4"
        }
      ]
    },
    {
      "id": "sw07-speicherbausteine-l3",
      "titel": "Enable, D-Latch und D-Flip-Flop",
      "art": "verstaendnis",
      "schritte": [
        {
          "typ": "theorie",
          "titel": "Transparente Latches",
          "bloecke": [
            {
              "typ": "text",
              "text": "Das SR-Latch reagiert **unmittelbar**: Eine Änderung am Eingang wirkt sofort am Ausgang. Man nennt es darum **transparentes Latch** (durchsichtig, als wäre es nicht da)."
            },
            {
              "typ": "text",
              "text": "Das **SR-Latch mit Enable** ist immer noch transparent. Mit dem Enable-Eingang E kann man die Ansteuerung aber **verhindern** (E = 0) oder **erlauben** (E = 1)."
            },
            {
              "typ": "text",
              "text": "Das **D-Latch** hat nur noch einen Dateneingang D (intern S = D, R = $\\overline{D}$). So kann der verbotene Zustand S = R = 1 nicht mehr auftreten. Die Funktionstabelle ist ganz einfach:"
            },
            {
              "typ": "formel",
              "tex": "Q_{n+1} = D_n \\quad (\\text{solange } E = 1)"
            }
          ],
          "quelle": "K07 Folien 7–8"
        },
        {
          "typ": "theorie",
          "titel": "Flankengetriggertes D-Flip-Flop",
          "bloecke": [
            {
              "typ": "text",
              "text": "Ein **flankengetriggertes D-FF** reagiert nur in einem sehr kurzen Zeitpunkt: bei der steigenden (oder je nach Typ fallenden) Flanke des Clock. Der Wert von D wird nur dann übernommen und bis zur nächsten Flanke gehalten."
            },
            {
              "typ": "kette",
              "elemente": [
                {
                  "text": "D"
                },
                {
                  "text": "D-Latch 1",
                  "sub": "Master, E = Clk invertiert"
                },
                {
                  "text": "D-Latch 2",
                  "sub": "Slave, E = Clk"
                },
                {
                  "text": "Q"
                }
              ],
              "pfeile": [
                "",
                "Q_1 = D_2",
                ""
              ]
            },
            {
              "typ": "text",
              "text": "**Grund: die Master-Slave-Architektur.** Solange Clk = 0 ist, folgt der Master dem Eingang D. Bei der steigenden Flanke speichert der Master, und erst jetzt wird sein Ausgang vom Slave übernommen."
            },
            {
              "typ": "merke",
              "text": "Flip-Flops sind flankengetriggert, Latches nicht. Manche Bücher brauchen «Flip-Flop» aber auch als Sammelbegriff für beides."
            }
          ],
          "quelle": "K07 Folie 9"
        },
        {
          "typ": "theorie",
          "titel": "Latch und Flip-Flop im Vergleich",
          "bloecke": [
            {
              "typ": "text",
              "text": "Beide hängen am gleichen D und am gleichen Clk. Schalte D um, während Clk = 1 ist, und schau, wer reagiert."
            },
            {
              "typ": "interaktiv",
              "widget": "latch_vs_ff"
            }
          ],
          "quelle": "K07 Folien 8–9"
        },
        {
          "typ": "multiple_choice",
          "frage": "Was bedeutet «transparent» bei einem Latch?",
          "optionen": [
            "Eine Änderung am Eingang wirkt sofort am Ausgang",
            "Das Latch hat keinen Ausgang",
            "Das Latch reagiert nur auf Flanken",
            "Das Latch speichert nie"
          ],
          "richtig": 0,
          "erklaerung": "Als wäre das Latch nicht da: Der Ausgang folgt dem Eingang direkt.",
          "quelle": "K07 Folie 7",
          "id": "sw07-speicherbausteine-l3-a1"
        },
        {
          "typ": "lueckentext",
          "text": "Für das D-Latch gilt (bei E = 1): $Q_{n+1}$ = ___",
          "antworten": [
            [
              "Dn",
              "D_n",
              "D"
            ]
          ],
          "erklaerung": "$Q_{n+1} = D_n$",
          "quelle": "K07 Folie 8",
          "id": "sw07-speicherbausteine-l3-a2"
        },
        {
          "typ": "wahr_falsch",
          "aussage": "Ein D-Latch kann nicht in den verbotenen Zustand S = R = 1 kommen.",
          "richtig": true,
          "erklaerung": "Intern ist R immer das Gegenteil von S.",
          "quelle": "K07 Folie 8",
          "id": "sw07-speicherbausteine-l3-a3"
        },
        {
          "typ": "multiple_choice",
          "frage": "Wann übernimmt ein flankengetriggertes D-FF (steigende Flanke) den Wert von D?",
          "optionen": [
            "Nur im Moment der steigenden Flanke",
            "Solange Clk = 1 ist",
            "Solange Clk = 0 ist",
            "Bei jeder Änderung von D"
          ],
          "richtig": 0,
          "erklaerung": "Danach hält es den Wert bis zur nächsten steigenden Flanke.",
          "quelle": "K07 Folie 9",
          "id": "sw07-speicherbausteine-l3-a4"
        },
        {
          "typ": "zuordnen",
          "frage": "Ordne zu: Wer ist bei welchem Clk-Pegel aktiv (Master-Slave, steigende Flanke)?",
          "paare": [
            [
              "Master (D-Latch 1)",
              "aktiv bei Clk = 0"
            ],
            [
              "Slave (D-Latch 2)",
              "aktiv bei Clk = 1"
            ]
          ],
          "erklaerung": "Der Master folgt D bei Clk = 0. Bei der steigenden Flanke speichert er, und der Slave übernimmt seinen Wert.",
          "quelle": "K07 Folie 9",
          "id": "sw07-speicherbausteine-l3-a5"
        }
      ]
    },
    {
      "id": "sw07-speicherbausteine-l4",
