      "art": "verstaendnis",
      "schritte": [
        {
          "typ": "theorie",
          "titel": "Das JK-Flip-Flop",
          "bloecke": [
            {
              "typ": "text",
              "text": "Das **JK-FF** ist eine Erweiterung des SR-FF: **J** entspricht S, **K** entspricht R."
            },
            {
              "typ": "text",
              "text": "Es gibt **keine verbotene Kombination** mehr: Bei J = K = 1 **wechselt** Q (von 0 auf 1 bzw. von 1 auf 0)."
            },
